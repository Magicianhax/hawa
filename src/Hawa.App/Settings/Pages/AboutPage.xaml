<UserControl x:Class="Hawa.App.Settings.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="About" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TextBlock Text="Hawa" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Opacity="0.7" Margin="0,4,0,12" />
        <TextBlock TextWrapping="Wrap" Text="AirPods battery, ear detection and auto-pause for Windows. Hawa means 'air' in Hindi, Urdu and Arabic." />
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.7"
                   Text="Battery and ear status come from Apple's Bluetooth LE proximity advertisements. Because AirPods rotate their address, another AirPods Pro 2 nearby with a stronger signal can occasionally be shown instead of yours." />
        <TextBlock Text="MIT licence" Opacity="0.7" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
