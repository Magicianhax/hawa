<Window x:Class="Hawa.App.Popup.PopupCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hawa.App.Popup"
        Width="320" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Opacity="0">
    <Border CornerRadius="16" Background="#E61C1C1E" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <Canvas Width="28" Height="28" Margin="0,0,10,0">
                    <Path Fill="White" Data="M7,3 a5,5 0 0 1 5,5 v3 a3,3 0 0 1 -3,3 h-1 v9 a2,2 0 0 1 -4,0 v-9 a4,4 0 0 1 -1,-8 z" />
                    <Path Fill="White" Data="M21,3 a5,5 0 0 0 -5,5 v3 a3,3 0 0 0 3,3 h1 v9 a2,2 0 0 0 4,0 v-9 a4,4 0 0 0 1,-8 z" />
                </Canvas>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="AirPods Pro" />
            </StackPanel>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,0">
                <local:BatteryRing x:Name="LeftRing" Label="Left" />
                <local:BatteryRing x:Name="RightRing" Label="Right" />
                <local:BatteryRing x:Name="CaseRing" Label="Case" />
            </UniformGrid>
        </Grid>
    </Border>
</Window>
